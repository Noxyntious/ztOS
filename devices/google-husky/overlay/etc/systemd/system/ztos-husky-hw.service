[Unit]
Description=Pixel 8 Pro: audio/sensor hub, Wi-Fi MAC, BT address
After=systemd-modules-load.service systemd-udevd.service
Before=bluetooth.service NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/ztos-husky-hw

[Install]
WantedBy=multi-user.target
